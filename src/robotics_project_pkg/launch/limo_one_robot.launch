
<launch>
  <arg name="robot_name"/>
  <arg name="init_x" default="0.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="init_yaw" default="0.0"/>

  <group ns="$(arg robot_name)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder '$(find robotics_project_pkg)/urdf/limo_four_diff.xacro' robot_namespace:=$(arg robot_name)" />

    <node name="spawn_limo_model" pkg="gazebo_ros" type="spawn_model" args="-x $(arg init_x) -y $(arg init_y) -z 0.0 -Y $(arg init_yaw) -unpause -urdf -param robot_description -model $(arg robot_name)" />

    <rosparam file="$(find limo_gazebo_sim)/config/limo_four_diff_control.yaml" command="load"/>
    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" args="limo_state_controller diff_drive_controller"/>
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
      <param name="publish_frequency" value="50.0"/>
    </node>

    <node pkg="slam_toolbox" type="sync_slam_toolbox_node" name="slam_toolbox" output="screen">
      <remap from="scan" to="limo/scan"/>
      <rosparam file="$(find robotics_project_pkg)/config/slam_toolbox_params.yaml" command="load" />
      <param name="odom_frame" value="$(arg robot_name)_odom"/>
      <param name="base_frame" value="$(arg robot_name)_base_footprint"/>
      <param name="map_frame" value="map"/> 
    </node>
    
    <node pkg="move_base" type="move_base" name="move_base" output="screen">
      <rosparam file="$(find robotics_project_pkg)/config/move_base.yaml" command="load" />
      <rosparam file="$(find robotics_project_pkg)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
      <rosparam file="$(find robotics_project_pkg)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
      <rosparam file="$(find robotics_project_pkg)/config/local_costmap_params.yaml" command="load" />
      <rosparam file="$(find robotics_project_pkg)/config/global_costmap_params.yaml" command="load" />
      <rosparam file="$(find robotics_project_pkg)/config/planner_global.yaml" command="load" />
      <rosparam file="$(find robotics_project_pkg)/config/planner_local.yaml" command="load" />
      
      <!-- Override frame names for multi-robot -->
      <param name="global_costmap/robot_base_frame" value="$(arg robot_name)_base_link"/>
      <param name="local_costmap/robot_base_frame" value="$(arg robot_name)_base_link"/>
      <param name="global_costmap/global_frame" value="map"/>
      <param name="local_costmap/global_frame" value="$(arg robot_name)_odom"/>
    </node>

    <node pkg="explore_lite" type="explore" respawn="true" name="explore_lite" output="screen">
      <rosparam file="$(find robotics_project_pkg)/config/explore_lite_params.yaml" command="load" />
      <param name="robot_base_frame" value="$(arg robot_name)/base_link"/>
      <remap from="costmap" to="/$(arg robot_name)/move_base/global_costmap/costmap"/>
      <remap from="costmap_updates" to="/$(arg robot_name)/move_base/global_costmap/costmap_updates"/>
    </node>   
  </group>
</launch>
