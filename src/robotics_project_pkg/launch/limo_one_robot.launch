<launch>
  <arg name="robot_name"/>
  <arg name="init_pose_x"/>
  <arg name="init_pose_y"/>
  <arg name="init_pose_z" default="0.0"/>
  <arg name="init_pose_yaw" default="0.0"/>

  <group ns="$(arg robot_name)">
    <!-- Load robot description with namespace -->
    <param name="robot_description" command="$(find xacro)/xacro --inorder '$(find robotics_project_pkg)/urdf/limo_four_diff.xacro' robot_namespace:=$(arg robot_name)" />

    <!-- Spawn robot in Gazebo -->
    <node name="spawn_limo_model" pkg="gazebo_ros" type="spawn_model" 
          args="-x $(arg init_pose_x) -y $(arg init_pose_y) -z $(arg init_pose_z) -Y $(arg init_pose_yaw) -unpause -urdf -param robot_description -model $(arg robot_name)" 
          output="screen"
          respawn="false"/>

    <!-- Load controller configuration -->
    <rosparam file="$(find limo_gazebo_sim)/config/limo_four_diff_control.yaml" command="load"/>

    <!-- Joint State Publisher -->
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
      <param name="use_gui" value="false"/>
      <remap from="joint_states" to="joint_states"/>
    </node>
    <param name="use_sim_time" value="true"/>

    <!-- Robot State Publisher with TF prefix 
         Publishes all static transforms from URDF with namespace prefix -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
      <param name="publish_frequency" value="50.0"/>
      <param name="tf_prefix" value="$(arg robot_name)"/>
      <remap from="joint_states" to="joint_states"/>
    </node>

    <!-- Move Base -->
    <node pkg="move_base" type="move_base" name="move_base" output="screen">
      <!-- Load all parameter files -->
      <rosparam file="$(find robotics_project_pkg)/config/move_base.yaml" command="load" />
      <rosparam file="$(find robotics_project_pkg)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
      <rosparam file="$(find robotics_project_pkg)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
      <rosparam file="$(find robotics_project_pkg)/config/local_costmap_params.yaml" command="load" />
      <rosparam file="$(find robotics_project_pkg)/config/global_costmap_params.yaml" command="load" />
      <rosparam file="$(find robotics_project_pkg)/config/planner.yaml" command="load" /> 
      
      <!-- Planner selection -->
      <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS" />
      <!-- <param name="base_global_planner" value="global_planner/GlobalPlanner" /> -->
      
      <!-- Global planner configuration - allow planning through unknown space -->
      <param name="GlobalPlanner/allow_unknown" value="true"/>
      <param name="GlobalPlanner/use_dijkstra" value="true"/>
      <param name="GlobalPlanner/use_quadratic" value="true"/>
      <!-- Very large tolerance for tight corridors -->
      <param name="GlobalPlanner/default_tolerance" value="1.0"/>
      <!-- Reduced cost factor to allow paths closer to obstacles -->
      <!-- <param name="GlobalPlanner/cost_factor" value="2.0"/> -->
      
      <!-- Transform tolerance for TF lookups -->
      <param name="transform_tolerance" value="0.5"/>
      
      <!-- Frame configuration -->
      <!-- Use 'world' as the root TF frame -->
      <param name="global_costmap/robot_base_frame" value="$(arg robot_name)/base_footprint"/>
      <param name="local_costmap/robot_base_frame" value="$(arg robot_name)/base_footprint"/>
      <!-- Costmaps are now expressed in the 'world' frame -->
      <param name="global_costmap/global_frame" value="world"/>
      <param name="local_costmap/global_frame" value="world"/>
      
      <!-- Map topic for static layer (relative to namespace) -->
      <param name="global_costmap/static_layer/map_topic" value="map"/>
      
      <!-- Observation sources configuration - ensure scan is properly remapped -->
      <param name="global_costmap/obstacle_layer/laser_scan_sensor/topic" value="scan"/>
      <param name="local_costmap/obstacle_layer/laser_scan_sensor/topic" value="scan"/>
      
      <!-- Increased inflation for multi-robot collision avoidance -->
      <!-- <param name="global_costmap/inflation_layer/inflation_radius" value="0.3"/> -->
      <!-- <param name="local_costmap/inflation_layer/inflation_radius" value="0.2"/> -->
      <!-- <param name="global_costmap/inflation_layer/cost_scaling_factor" value="3.0"/> -->
      
      <!-- Enable verbose output for debugging -->
      <param name="clearing_rotation_allowed" value="true"/>
      
      <!-- Topic remapping for cmd_vel -->
      <remap from="cmd_vel" to="cmd_vel"/>
      <remap from="odom" to="odom"/>
      
      <!-- Observation sources remapping -->
      <remap from="scan" to="scan"/>
    </node>

    <!-- Explore Lite for autonomous exploration -->
    <node pkg="explore_lite" type="explore" respawn="true" name="explore" output="screen">
      <rosparam file="$(find robotics_project_pkg)/config/explore_lite_params.yaml" command="load" />
      
      <!-- Frame configuration - SLASH notation for TF frames -->
      <param name="robot_base_frame" value="$(arg robot_name)/base_footprint"/>
      
      <!-- Topic remapping (use relative paths within namespace) -->
      <remap from="map" to="map"/>
      <remap from="costmap" to="move_base/global_costmap/costmap"/>
      <remap from="costmap_updates" to="move_base/global_costmap/costmap_updates"/>
      <remap from="move_base" to="move_base"/>
      
      <!-- Enable visualization for debugging -->
      <param name="visualize" value="true"/>
    </node>

  </group>

  <!-- SLAM Toolbox - run outside the per-robot namespace.
       Each include of this launch file will start its own node with a unique name
       and explicitly remap topics to that robot's scan/map. -->
  <node pkg="slam_toolbox" type="sync_slam_toolbox_node"
        name="$(arg robot_name)_slam_toolbox" output="screen">
    <!-- Map slam_toolbox's absolute topics to the robot-specific ones -->
    <remap from="/scan"         to="/$(arg robot_name)/scan"/>
    <remap from="/map"          to="/$(arg robot_name)/map"/>
    <remap from="/map_metadata" to="/$(arg robot_name)/map_metadata"/>
    
    <!-- Load parameters -->
    <rosparam file="$(find robotics_project_pkg)/config/slam_toolbox_params.yaml" command="load" />
    
    <!-- Frame names - use 'world' as the root TF frame -->
    <param name="odom_frame" value="$(arg robot_name)/odom"/>
    <param name="base_frame" value="$(arg robot_name)/base_footprint"/>
    <!-- SLAM will publish transforms with 'world' as the map/root frame -->
    <param name="map_frame" value="world"/>
    <param name="scan_topic" value="/$(arg robot_name)/scan"/>
    
    <!-- SLAM configuration overrides -->
    <param name="mode" value="mapping"/>
    <param name="transform_publish_period" value="0.02"/>
    <param name="map_update_interval" value="1.0"/>
    <param name="resolution" value="0.05"/>
    <param name="max_laser_range" value="8.0"/>
    <param name="minimum_travel_distance" value="0.2"/>
    <param name="minimum_travel_heading" value="0.2"/>
  </node>

</launch>