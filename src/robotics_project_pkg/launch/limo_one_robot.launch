<launch>
  <arg name="robot_name"/>
    <arg name="init_pose_x"/>
    <arg name="init_pose_y"/>
    <arg name="init_pose_z" default="0.0"/>
    <arg name="init_pose_yaw" default="0.0"/>


  <group ns="$(arg robot_name)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder '$(find robotics_project_pkg)/urdf/limo_four_diff.xacro' robot_namespace:=$(arg robot_name)" />

    <node name="spawn_limo_model" pkg="gazebo_ros" type="spawn_model" 
          args="-x $(arg init_pose_x) -y $(arg init_pose_y) -z $(arg init_pose_z) -Y $(arg init_pose_yaw) -unpause -urdf -param robot_description -model $(arg robot_name)" />


    <rosparam file="$(find limo_gazebo_sim)/config/limo_four_diff_control.yaml" command="load"/>

    <!-- <node name="controller_spawner" pkg="controller_manager" type="spawner"
              respawn="false" output="screen" args="limo_state_controller"/> -->

    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

    <param name="map_merge/init_pose_x" value="$(arg init_pose_x)"/>
    <param name="map_merge/init_pose_y" value="$(arg init_pose_y)"/>
    <param name="map_merge/init_pose_z" value="$(arg init_pose_z)"/>
    <param name="map_merge/init_pose_yaw" value="$(arg init_pose_yaw)"/>



    <!-- SLAM Toolbox - FIXED: Use underscore format to match URDF -->
    <node pkg="slam_toolbox" type="sync_slam_toolbox_node" name="slam_toolbox" output="screen">
      <remap from="/scan" to="scan"/>
      <remap from="/map" to="map"/>
      <remap from="/map_metadata" to="map_metadata"/>
      <rosparam file="$(find robotics_project_pkg)/config/slam_toolbox_params.yaml" command="load" />
      
      <!-- CRITICAL: Must match URDF frame names (underscore format) -->
      <param name="odom_frame" value="$(arg robot_name)_odom"/>
      <param name="base_frame" value="$(arg robot_name)_base_link"/>
      <param name="map_frame" value="$(arg robot_name)_map"/>
      
      <!-- IMPORTANT: Disable map-to-odom publishing if not mapping mode -->
      <param name="mode" value="mapping"/>
    </node>
    
    <!-- Move Base - FIXED: Update frame names to match URDF -->
    <node pkg="move_base" type="move_base" name="move_base" output="screen">
      <rosparam file="$(find robotics_project_pkg)/config/move_base.yaml" command="load" />
      <rosparam file="$(find robotics_project_pkg)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
      <rosparam file="$(find robotics_project_pkg)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
      <rosparam file="$(find robotics_project_pkg)/config/local_costmap_params.yaml" command="load" />
      <rosparam file="$(find robotics_project_pkg)/config/global_costmap_params.yaml" command="load" />
      <rosparam file="$(find robotics_project_pkg)/config/planner_global.yaml" command="load" />
      <rosparam file="$(find robotics_project_pkg)/config/planner_local.yaml" command="load" />
      
      <!-- Frame configuration - Match URDF frames (underscore format) -->
      <param name="global_costmap/robot_base_frame" value="$(arg robot_name)_base_link"/>
      <param name="local_costmap/robot_base_frame" value="$(arg robot_name)_base_link"/>
      <param name="global_costmap/global_frame" value="$(arg robot_name)_map"/>
      <param name="local_costmap/global_frame" value="$(arg robot_name)_odom"/>
      
      <!-- Override sensor frame for namespaced laser -->
      <param name="global_costmap/obstacle_layer/laser_scan_sensor/sensor_frame" value="$(arg robot_name)_laser_link"/>
      <param name="local_costmap/obstacle_layer/laser_scan_sensor/sensor_frame" value="$(arg robot_name)_laser_link"/>
    </node>

            <node pkg="explore_lite" type="explore" respawn="false" name="explore" output="screen">
            <param name="robot_base_frame" value="$(arg robot_name)_base_link"/>
            <param name="costmap_topic" value="move_base/global_costmap/costmap"/>
            <param name="costmap_updates_topic" value="move_base/global_costmap/costmap_updates"/>
            <param name="visualize" value="true"/>
            <param name="planner_frequency" value="1.0"/>
            <param name="progress_timeout" value="60.0"/>
            <param name="potential_scale" value="1.0"/>
            <param name="orientation_scale" value="0.0"/>
            <param name="gain_scale" value="1.0"/>
            <param name="transform_tolerance" value="0.5"/>
            <param name="min_frontier_size" value="0.5"/>
        </node>



    <!-- Explore Lite - Each robot explores autonomously -->
    <!-- <node pkg="explore_lite" type="explore" respawn="true" name="explore_lite" output="screen">
      <rosparam file="$(find robotics_project_pkg)/config/explore_lite_params.yaml" command="load" />
      <param name="robot_base_frame" value="$(arg robot_name)_base_link"/>
      <remap from="costmap" to="move_base/global_costmap/costmap"/>
      <remap from="costmap_updates" to="move_base/global_costmap/costmap_updates"/>
    </node> -->
  </group>
</launch>