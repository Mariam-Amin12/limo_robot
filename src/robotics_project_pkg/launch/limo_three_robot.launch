<launch>
  <arg name="gui" default="true"/>
  <param name="use_sim_time" value="true"/>

  <!-- Start Gazebo -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find robotics_project_pkg)/worlds/test_world_1.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <!-- Robot 1 with map_merge parameters -->
  <group ns="robot1">
    <param name="map_merge/init_pose_x" value="0.5"/>
    <param name="map_merge/init_pose_y" value="0.5"/>
    <param name="map_merge/init_pose_z" value="0.0"/>
    <param name="map_merge/init_pose_yaw" value="0.0"/>
  </group>
  
  <include file="$(find robotics_project_pkg)/launch/limo_one_robot.launch">
    <arg name="robot_name" value="robot1"/>
    <arg name="init_x" value="0.5"/>
    <arg name="init_y" value="0.5"/>
    <arg name="init_yaw" value="0.0"/>
  </include>

  <!-- Robot 2 with map_merge parameters -->
  <group ns="robot2">
    <param name="map_merge/init_pose_x" value="14.0"/>
    <param name="map_merge/init_pose_y" value="0.5"/>
    <param name="map_merge/init_pose_z" value="0.0"/>
    <param name="map_merge/init_pose_yaw" value="1.57"/>
  </group>
  
  <include file="$(find robotics_project_pkg)/launch/limo_one_robot.launch">
    <arg name="robot_name" value="robot2"/>
    <arg name="init_x" value="14.0"/>
    <arg name="init_y" value="0.5"/>
    <arg name="init_yaw" value="1.57"/>
  </include>

  <!-- Robot 3 with map_merge parameters -->
  <group ns="robot3">
    <param name="map_merge/init_pose_x" value="0.5"/>
    <param name="map_merge/init_pose_y" value="12.0"/>
    <param name="map_merge/init_pose_z" value="0.0"/>
    <param name="map_merge/init_pose_yaw" value="-1.57"/>
  </group>
  
  <include file="$(find robotics_project_pkg)/launch/limo_one_robot.launch">
    <arg name="robot_name" value="robot3"/>
    <arg name="init_x" value="0.5"/>
    <arg name="init_y" value="12.0"/>
    <arg name="init_yaw" value="-1.57"/>
  </include>

  <!-- Map Merge Node -->
  <node pkg="multirobot_map_merge" type="map_merge" name="map_merge" output="screen">
    <param name="robot_map_topic" value="map"/>
    <param name="known_init_poses" value="true"/>
    <param name="robot_map_updates_topic" value="map_updates"/>
    <param name="world_frame" value="map"/>
    <param name="merged_map_topic" value="merged_map"/>
    <param name="merging_rate" value="2.0"/>
    <rosparam param="robot_namespaces">[robot1, robot2, robot3]</rosparam>
  </node>

  
  <!-- RViz -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find robotics_project_pkg)/rviz/multi_config.rviz"/>
</launch>