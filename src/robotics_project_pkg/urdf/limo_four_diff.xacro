<?xml version="1.0"?>
<robot name="limo_four_diff" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:arg name="robot_namespace" default="robot"/>
    <!-- Expose namespace as property for included files -->
    <xacro:property name="ns" value="$(arg robot_namespace)"/>

    <!-- 2. Include other Xacro files -->
    <xacro:include filename="$(find robotics_project_pkg)/urdf/limo_xacro.xacro" /> 
    <xacro:include filename="$(find robotics_project_pkg)/urdf/limo_four_diff.gazebo" />
    <!-- Variables -->
    <xacro:property name="M_PI" value="3.14159"/>

    <!-- Vehicle Geometries -->
    <xacro:property name="base_x_size" value="0.13" />
    <xacro:property name="base_y_size" value="0.12" />
    <xacro:property name="base_z_size" value="0.1" />
  
    <xacro:property name="wheelbase" value="0.2"/>
    <xacro:property name="track" value="0.13"/>
    <xacro:property name="wheel_vertical_offset" value="-0.10" />
    <xacro:property name="base_mass" value="2.1557"/>

    <xacro:property name="wheel_length" value="0.045" />
    <xacro:property name="wheel_radius" value="0.045" />

    <!-- Base footprint -->
    <link name="${ns}_base_footprint"/>

    <joint name="${ns}_base_joint" type="fixed">
        <parent link="${ns}_base_footprint"/>
        <child link="${ns}_base_link"/>
        <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
    </joint>

    <!-- Base link -->
    <link name="${ns}_base_link">
        <visual>
            <origin xyz="0 0 -0.15" rpy="0 0 1.57" />
            <geometry>
                <mesh filename="package://limo_description/meshes/limo_base.dae" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${base_x_size} ${base_y_size} ${base_z_size}"/>
            </geometry>
        </collision>
    </link>

    <!-- Inertial -->
    <link name="${ns}_inertial_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" />
            <mass value="${base_mass}" />
            <inertia ixx="0.24" ixy="0" ixz="0" 
                     iyy="0.96" iyz="0" 
                     izz="0.96" />
        </inertial>
    </link>

    <joint name="${ns}_inertial_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="${ns}_base_link" />
        <child link="${ns}_inertial_link" />
    </joint>

    <!-- Laser -->
    <xacro:limo_laser parent_prefix="${ns}_base_link" frame_prefix="${ns}_laser">
        <origin xyz="0.103 0 -0.034" rpy="0 0 0"/>
    </xacro:limo_laser>

    <!-- Depth camera -->
    <xacro:limo_depth_camera parent_prefix="${ns}_base_link" frame_prefix="${ns}_depth_camera">
        <origin xyz="0.084 0 0.03" rpy="0 0 0"/>
    </xacro:limo_depth_camera>

    <!-- IMU -->
    <xacro:limo_imu parent_prefix="${ns}_base_link" frame_prefix="${ns}_imu">
        <origin xyz="0.0 0 -0.1" rpy="0 0 0"/>
    </xacro:limo_imu>

    <!-- Wheels -->
    <xacro:limo_wheel parent_prefix="${ns}_base_link" wheel_prefix="${ns}_front_left" reflect="1">
        <origin xyz="${wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0 0" />
    </xacro:limo_wheel>

    <xacro:limo_wheel parent_prefix="${ns}_base_link" wheel_prefix="${ns}_front_right" reflect="-1">
        <origin xyz="${wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="${M_PI} 0 0" />
    </xacro:limo_wheel>

    <xacro:limo_wheel parent_prefix="${ns}_base_link" wheel_prefix="${ns}_rear_left" reflect="1">
        <origin xyz="${-wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0 0" />
    </xacro:limo_wheel>

    <xacro:limo_wheel parent_prefix="${ns}_base_link" wheel_prefix="${ns}_rear_right" reflect="-1">
        <origin xyz="${-wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="${M_PI} 0 0" />
    </xacro:limo_wheel>

</robot>