Panels:
  - Class: rviz/Displays
    Name: Displays
    Splitter Ratio: 0.5
  - Class: rviz/Views
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      
    # Robot 1
    - Class: rviz/RobotModel
      Name: Robot1 Model
      Enabled: true
      Robot Description: /robot1/robot_description
      TF Prefix: robot1
      Visual Enabled: true
      Collision Enabled: false
      
    - Class: rviz/LaserScan
      Name: Robot1 LaserScan
      Topic: /robot1/limo/scan
      Enabled: true
      Color: 255; 0; 0
      Size: 0.05
      Style: Points
      
    - Class: rviz/Map
      Name: Robot1 Map
      Topic: /robot1/map
      Enabled: true
      Color Scheme: map
      Draw Behind: false
      Alpha: 0.7
      Use Timestamp: false
      
    # Robot 2
    - Class: rviz/RobotModel
      Name: Robot2 Model
      Enabled: true
      Robot Description: /robot2/robot_description
      TF Prefix: robot2
      Visual Enabled: true
      Collision Enabled: false
      
    - Class: rviz/LaserScan
      Name: Robot2 LaserScan
      Topic: /robot2/limo/scan
      Enabled: true
      Color: 0; 255; 0
      Size: 0.05
      Style: Points
      
    - Class: rviz/Map
      Name: Robot2 Map
      Topic: /robot2/map
      Enabled: true
      Color Scheme: map
      Draw Behind: false
      Alpha: 0.7
      Use Timestamp: false
      
    # Robot 3
    - Class: rviz/RobotModel
      Name: Robot3 Model
      Enabled: true
      Robot Description: /robot3/robot_description
      TF Prefix: robot3
      Visual Enabled: true
      Collision Enabled: false
      
    - Class: rviz/LaserScan
      Name: Robot3 LaserScan
      Topic: /robot3/limo/scan
      Enabled: true
      Color: 0; 0; 255
      Size: 0.05
      Style: Points
      
    - Class: rviz/Map
      Name: Robot3 Map
      Topic: /robot3/map
      Enabled: true
      Color Scheme: map
      Draw Behind: false
      Alpha: 0.7
      Use Timestamp: false
      
    # TF for all robots
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.3
      
    # Paths (if available)
    - Class: rviz/Path
      Name: Robot1 Path
      Topic: /robot1/move_base/NavfnROS/plan
      Enabled: false
      Color: 255; 0; 0
      Line Style: Lines
      
    - Class: rviz/Path
      Name: Robot2 Path
      Topic: /robot2/move_base/NavfnROS/plan
      Enabled: false
      Color: 0; 255; 0
      Line Style: Lines
      
    - Class: rviz/Path
      Name: Robot3 Path
      Topic: /robot3/move_base/NavfnROS/plan
      Enabled: false
      Color: 0; 0; 255
      Line Style: Lines
      
  Global Options:
    Fixed Frame: robot1/map
    Background Color: 48; 48; 48
    
  Views:
    Current:
      Class: rviz/Orbit
      Name: Orbit
      Distance: 25.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.0472
      Target Frame: <Fixed Frame>
      Yaw: 0.785398
      Focal Point:
        X: 7.5
        Y: 7.5
        Z: 0

Window Geometry:
  Displays:
    collapsed: false
  Height: 1200
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1600

